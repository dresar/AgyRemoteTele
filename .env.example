TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_CHAT_IDS=
ADMIN_AUTH_KEY=your_secret_admin_pairing_key
DEFAULT_PROFILE=agy01
PROFILES_ROOT=/opt/data/home/agy-profiles
AGY_BIN_PATH=/opt/data/home/.local/bin/agy
WORKSPACE_ROOT=/opt/data/home
EXECUTION_TIMEOUT=1800s
SESSION_FILE_PATH=/opt/data/home/AgyRemoteTele/data/sessions.json
RATE_LIMIT_PER_MINUTE=30
SESSION_EXPIRATION_HOURS=72
